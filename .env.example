# ==========================================
# KONFIGURASI UTAMA APLIKASI
# ==========================================
PORT=3006
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Limit Token Keamanan & Biaya
DAILY_TOKEN_LIMIT=500000
MONTHLY_TOKEN_LIMIT=5000000

# ==========================================
# INTEGRASI ARSITEKTUR ENTERPRISE (OPSIONAL)
# ==========================================

# 1. Secure Private Vector Store (Qdrant)
# Jalankan via docker: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pln_renewables_kb

# 2. FastAPI Dense Vector Embedding (BAAI/bge-small-en-v1.5 / Fasma-S-70B)
# Endpoint FastAPI python untuk dense vector embedding
FASTAPI_EMBEDDING_URL=http://localhost:8001/embeddings

# 3. FastAPI Reranker Model (BAAI/bge-reranker-base)
# Endpoint FastAPI python untuk re-ranking Top-K chunks
RERANKER_API_URL=http://localhost:8002/rerank

# 4. Private Model LLM (vLLM / Llama-3-70B-Private On-Premise)
# Jika menggunakan infrastruktur GPU internal PLN
PRIVATE_LLM_URL=http://localhost:8000/v1
PRIVATE_LLM_MODEL=Llama-3-70B-Instruct-Private
